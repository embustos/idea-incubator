# Public mobile configuration. EXPO_PUBLIC_ values are bundled into the app.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Server-only secrets belong in apps/api/.env.local for local development and
# in Railway service variables for deployed environments. Never expose these
# values through an EXPO_PUBLIC_ variable.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/idea_incubator
OPENAI_API_KEY=
